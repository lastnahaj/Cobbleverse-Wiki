---
import { navigation, server } from "../data";
import { withBase } from "../lib/basePath";
---

<footer class="site-footer">
  <div class="site-footer__route" aria-hidden="true">
    <span></span><i></i><span></span><i></i><span></span>
  </div>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img
        src={withBase("/assets/logo-mark-monochrome.png")}
        width="768"
        height="672"
        alt=""
        loading="lazy"
      />
      <div>
        <strong>Cobbleverse Wiki</strong><p>
          The official field guide for the Cobbleverse community.
        </p>
      </div>
    </div>
    <nav aria-label="Footer navigation">
      {
        navigation
          .slice(1)
          .map((item) => <a href={withBase(item.href)}>{item.label}</a>)
      }
    </nav>
    <div class="site-footer__links">
      <a href={server.website}>Infinite Gaming Servers ↗</a>
      <a href={server.discord}>Discord ↗</a>
    </div>
  </div>
  <div class="site-footer__legal">
    <span
      >Community documentation for {server.game}
      {server.minecraftVersion} · {server.loader}</span
    >
    <span>Built for explorers, battlers, collectors, and builders.</span>
  </div>
</footer>
