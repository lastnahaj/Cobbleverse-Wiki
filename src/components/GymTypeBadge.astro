---
interface Props {
  type: string;
  status?: string;
}
const { type, status } = Astro.props;
---

<span
  class="gym-type"
  style={`--type-hue: ${Math.abs([...type].reduce((sum, char) => sum + char.charCodeAt(0), 0) * 19) % 360}`}
  ><i aria-hidden="true"></i>{type}{status && <small>{status}</small>}</span
>
