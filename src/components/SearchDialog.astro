---
import { withBase } from "../lib/basePath";

const indexUrl = withBase("/search-index.json");
---

<dialog class="search-dialog" id="wiki-search" aria-labelledby="search-title">
  <div class="search-dialog__panel" data-search-panel data-index-url={indexUrl}>
    <header class="search-dialog__header">
      <div>
        <span class="eyebrow">Field index</span>
        <h2 id="search-title">Search Cobbleverse Wiki</h2>
      </div>
      <button
        class="icon-button"
        type="button"
        data-search-close
        aria-label="Close search">×</button
      >
    </header>
    <label class="search-input">
      <span class="visually-hidden">Search guides and reference pages</span>
      <svg aria-hidden="true" viewBox="0 0 24 24"
        ><path d="m21 21-4.5-4.5m2.5-5A7.5 7.5 0 1 1 4 11.5a7.5 7.5 0 0 1 15 0Z"
        ></path></svg
      >
      <input
        data-search-input
        type="search"
        autocomplete="off"
        placeholder="Search regions, claims, ranks…"
      />
      <kbd>/</kbd>
    </label>
    <p class="search-dialog__hint" data-search-status>
      Start typing to search published wiki pages.
    </p>
    <div
      class="search-results"
      data-search-results
      role="listbox"
      aria-label="Search results"
    >
    </div>
    <footer class="search-dialog__footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
      <span><kbd>Enter</kbd> Open</span>
      <span><kbd>Esc</kbd> Close</span>
    </footer>
  </div>
</dialog>

<script>
  import Fuse from "fuse.js";

  type SearchEntry = {
    title: string;
    description: string;
    category: string;
    headings: string[];
    excerpt: string;
    tags: string[];
    aliases: string[];
    url: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>("#wiki-search");
  const panel = dialog?.querySelector<HTMLElement>("[data-search-panel]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const results = dialog?.querySelector<HTMLElement>("[data-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-search-status]");
  const openButtons =
    document.querySelectorAll<HTMLElement>("[data-search-open]");
  const closeButton = dialog?.querySelector<HTMLElement>("[data-search-close]");
  let fusePromise: Promise<Fuse<SearchEntry>> | undefined;
  let activeIndex = -1;

  function loadIndex() {
    if (!fusePromise && panel?.dataset.indexUrl) {
      fusePromise = fetch(panel.dataset.indexUrl)
        .then((response) => {
          if (!response.ok)
            throw new Error("Search index could not be loaded.");
          return response.json() as Promise<SearchEntry[]>;
        })
        .then(
          (entries) =>
            new Fuse(entries, {
              keys: [
                { name: "title", weight: 0.35 },
                { name: "aliases", weight: 0.2 },
                { name: "headings", weight: 0.16 },
                { name: "tags", weight: 0.12 },
                { name: "description", weight: 0.1 },
                { name: "excerpt", weight: 0.07 },
              ],
              threshold: 0.36,
              ignoreLocation: true,
            }),
        );
    }
    return fusePromise;
  }

  function openSearch() {
    if (!dialog?.open) dialog?.showModal();
    loadIndex();
    requestAnimationFrame(() => input?.focus());
  }

  function closeSearch() {
    dialog?.close();
    if (input) input.value = "";
    if (results) results.innerHTML = "";
    if (status)
      status.textContent = "Start typing to search published wiki pages.";
    activeIndex = -1;
  }

  function selectResult(index: number) {
    const links = Array.from(
      results?.querySelectorAll<HTMLAnchorElement>("a") ?? [],
    );
    if (!links.length) return;
    activeIndex = (index + links.length) % links.length;
    links.forEach((link, itemIndex) =>
      link.classList.toggle("is-active", itemIndex === activeIndex),
    );
    links[activeIndex]?.focus();
  }

  function renderResults(entries: SearchEntry[]) {
    if (!results || !status) return;
    activeIndex = -1;
    if (!entries.length) {
      results.innerHTML =
        '<div class="search-empty">No published pages matched that search.</div>';
      status.textContent = "Try a broader word or a section name.";
      return;
    }
    status.textContent = `${entries.length} result${entries.length === 1 ? "" : "s"}`;
    results.innerHTML = entries
      .map(
        (entry) => `<a class="search-result" role="option" href="${entry.url}">
          <span class="search-result__category">${entry.category}</span>
          <strong>${entry.title}</strong>
          <span>${entry.description || entry.excerpt}</span>
        </a>`,
      )
      .join("");
  }

  openButtons.forEach((button) => button.addEventListener("click", openSearch));
  closeButton?.addEventListener("click", closeSearch);
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });
  input?.addEventListener("input", async () => {
    const query = input.value.trim();
    if (!query) {
      renderResults([]);
      if (results) results.innerHTML = "";
      if (status)
        status.textContent = "Start typing to search published wiki pages.";
      return;
    }
    if (status) status.textContent = "Searching the field index…";
    try {
      const fuse = await loadIndex();
      renderResults(
        fuse?.search(query, { limit: 8 }).map((result) => result.item) ?? [],
      );
    } catch {
      if (status)
        status.textContent =
          "Search is unavailable. Browse a section from the navigation.";
    }
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      selectResult(activeIndex + 1);
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      selectResult(activeIndex - 1);
    } else if (event.key === "Enter" && activeIndex >= 0) {
      const links = results?.querySelectorAll<HTMLAnchorElement>("a");
      links?.[activeIndex]?.click();
    }
  });
  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;
    const isTyping = target.matches(
      "input, textarea, select, [contenteditable='true']",
    );
    if (
      event.key === "/" &&
      !isTyping &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.altKey
    ) {
      event.preventDefault();
      openSearch();
    }
  });
</script>
