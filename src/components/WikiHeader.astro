---
import { navigation } from "../data";
import { withBase } from "../lib/basePath";
import MobileNav from "./MobileNav.astro";
---

<header class="site-header">
  <div class="site-header__inner">
    <button
      class="nav-toggle"
      type="button"
      data-mobile-nav-toggle
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"><span></span><span></span><span></span></button
    >
    <a class="brand" href={withBase("/")}
      ><img
        src={withBase("/assets/brand/cobbleverse-crest.webp")}
        width="1254"
        height="1254"
        alt=""
      /><span
        ><strong>Cobbleverse</strong><small
          >Infinite Gaming Servers · Wiki</small
        ></span
      ></a
    >
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        <li><a href={withBase("/getting-started/")}>Start playing</a></li>{
          ["Gameplay", "Server", "Reference"].map((group) => (
            <li class="nav-more">
              <details name="primary-navigation">
                <>
                  <summary>{group}</summary>
                  <div class="nav-more__menu">
                    {navigation
                      .filter((item) => item.group === group)
                      .map((item) => (
                        <a href={withBase(item.href)}>{item.label}</a>
                      ))}
                  </div>
                </>
              </details>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="search-button"
      type="button"
      data-search-open
      aria-label="Search wiki"><span>Search</span><kbd>/</kbd></button
    >
  </div>
</header><MobileNav />

<script>
  const desktopNav = document.querySelector<HTMLElement>(".desktop-nav");
  if (desktopNav) {
    const menus = Array.from(
      desktopNav.querySelectorAll<HTMLDetailsElement>("details"),
    );
    const closeMenus = (except?: HTMLDetailsElement) => {
      menus.forEach((menu) => {
        if (menu !== except) menu.open = false;
      });
    };
    // Close siblings synchronously, including in browsers without grouped details.
    desktopNav.addEventListener("click", (event) => {
      const target = event.target as Element;
      const summary = target.closest("summary");
      if (summary) closeMenus(summary.closest("details")!);
      else if (target.closest("a")) closeMenus();
    });
    document.addEventListener("pointerdown", (event) => {
      if (!desktopNav.contains(event.target as Node)) closeMenus();
    });
    document.addEventListener("focusin", (event) => {
      const menu = (event.target as Element).closest<HTMLDetailsElement>(
        ".desktop-nav details",
      );
      closeMenus(menu ?? undefined);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openMenu = menus.find((menu) => menu.open);
      if (!openMenu) return;
      event.preventDefault();
      closeMenus();
      openMenu.querySelector("summary")?.focus();
    });
    window
      .matchMedia("(max-width: 1180px)")
      .addEventListener("change", () => closeMenus());
  }
</script>
