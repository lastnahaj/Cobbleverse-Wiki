---
import { navigation } from "../data";
import { withBase } from "../lib/basePath";
import MobileNav from "./MobileNav.astro";
---

<header class="site-header">
  <div class="site-header__inner">
    <button
      class="nav-toggle"
      type="button"
      data-mobile-nav-toggle
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"><span></span><span></span><span></span></button
    >
    <a class="brand" href={withBase("/")}
      ><img
        src={withBase("/assets/brand/cobbleverse-crest.webp")}
        width="1254"
        height="1254"
        alt=""
      /><span
        ><strong>Cobbleverse</strong><small
          >Infinite Gaming Servers · Wiki</small
        ></span
      ></a
    >
    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        <li><a href={withBase("/getting-started/")}>Start playing</a></li>{
          ["Gameplay", "Server", "Reference"].map((group) => (
            <li class="nav-more">
              <details>
                <>
                  <summary>{group}</summary>
                  <div class="nav-more__menu">
                    {navigation
                      .filter((item) => item.group === group)
                      .map((item) => (
                        <a href={withBase(item.href)}>{item.label}</a>
                      ))}
                  </div>
                </>
              </details>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="search-button"
      type="button"
      data-search-open
      aria-label="Search wiki"><span>Search</span><kbd>/</kbd></button
    >
  </div>
</header><MobileNav />
