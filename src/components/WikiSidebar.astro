---
import { navigation } from "../data";
import { withBase, withoutBase } from "../lib/basePath";

const currentPath = withoutBase(Astro.url.pathname);
const sectionLinks = [
  { label: "Install & connect", href: "/getting-started/install/" },
  { label: "Troubleshooting", href: "/getting-started/troubleshooting/" },
  { label: "Region route", href: "/progression/regions/" },
  { label: "Legendary routes", href: "/progression/legendary-mythical/" },
  { label: "Gym Leaders", href: "/gyms/" },
  { label: "Structures", href: "/worlds/structures/" },
  { label: "Commands", href: "/commands/" },
];
---

<aside class="wiki-sidebar" aria-label="Wiki sections">
  <span class="wiki-sidebar__label">Wiki sections</span>
  <nav>
    <ul>
      {
        navigation.slice(1).map((item) => (
          <li>
            <a
              class:list={{ active: currentPath.startsWith(item.href) }}
              href={withBase(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="wiki-sidebar__subnav">
    <span>Quick reference</span>
    {
      sectionLinks.map((item) => (
        <a
          class:list={{ active: currentPath === item.href }}
          href={withBase(item.href)}
        >
          {item.label}
        </a>
      ))
    }
  </div>
</aside>
