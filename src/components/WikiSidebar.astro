---
import { navigation } from "../data";
import { withBase, withoutBase } from "../lib/basePath";
const currentPath = withoutBase(Astro.url.pathname);
---

<aside class="wiki-sidebar" aria-label="Wiki sections">
  <nav>
    {
      ["Start", "Gameplay", "Server", "Reference"].map((group) => (
        <section>
          <>
            <span class="wiki-sidebar__label">{group}</span>
            <ul>
              {navigation
                .filter((item) => item.group === group)
                .map((item) => (
                  <li>
                    <a
                      class:list={{
                        active:
                          item.href === "/"
                            ? currentPath === "/"
                            : currentPath.startsWith(item.href),
                      }}
                      href={withBase(item.href)}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
            </ul>
          </>
        </section>
      ))
    }
  </nav>
</aside>
