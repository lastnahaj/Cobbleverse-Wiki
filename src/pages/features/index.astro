---
import FeatureStatusBadge from "../../components/FeatureStatusBadge.astro";
import InfoCallout from "../../components/InfoCallout.astro";
import { features } from "../../data";
import { withBase } from "../../lib/basePath";
import PageShell from "../../layouts/PageShell.astro";

const headings = [
  { depth: 2, slug: "system-directory", text: "System directory" },
  { depth: 2, slug: "status-model", text: "Status model" },
  { depth: 2, slug: "client-options", text: "Client options" },
];
---

<PageShell
  title="Server Systems"
  description="Browse active Cobbleverse quests, markets, battles, automation, claims, rewards, menus, and optional client features."
  category="Features"
  hero="/assets/sections/art-server-systems.webp"
  {headings}
  related={[
    { href: "/features/neoplushies/", title: "NeoPlushies" },
    { href: "/battle-tower/", title: "Battle Tower" },
  ]}
>
  <h2 id="system-directory">System directory</h2>
  <div class="feature-directory">
    {
      features
        .filter((feature) => feature.playerFacing)
        .map((feature) => (
          <a href={withBase(`/features/${feature.id}/`)}>
            <>
              <span>
                <>
                  <strong>{feature.name}</strong>
                  <small>{feature.category}</small>
                </>
              </span>
              <FeatureStatusBadge status={feature.status} />
              <i>→</i>
            </>
          </a>
        ))
    }
  </div>
  <h2 id="status-model">Status labels</h2>
  <p>
    Active systems are installed on Cobbleverse. Optional-client entries can be
    added locally and do not define server gameplay.
  </p>
  <InfoCallout title="Configuration varies"
    ><p>
      Upstream documentation explains what each mod can do. This wiki calls out
      settings—fees, cooldowns, rewards, aliases, rates, and permissions—that
      remain controlled by the server.
    </p></InfoCallout
  >
  <h2 id="client-options">Client options</h2>
  <p>
    Simple Voice Chat and Distant Horizons are listed as optional client tools.
    Confirm compatibility with the required pack before adding either to your
    profile.
  </p>
</PageShell>
