---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { regionalGyms } from "../../data";
import { withBase } from "../../lib/basePath";
import "../../styles/catalogue.css";
import "../../styles/leagues.css";
const regions = ["Kanto", "Johto", "Hoenn", "Sinnoh"];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout
  title="Gyms and Regional Leagues"
  description="Plan all 52 regional checkpoints with leader locations, badges, signature items, league rewards, and a personal checklist."
>
  <div class="catalogue" data-leagues>
    <nav class="catalogue-breadcrumb" aria-label="Breadcrumb">
      <a href={withBase("/")}>Wiki</a><span>/</span><span>Gyms & Leagues</span>
    </nav>
    <header class="catalogue-heading">
      <span class="eyebrow">Cobbleverse · Regional journey</span><h1>
        Gyms & Leagues
      </h1><p>
        Find your next Leader, check the signature item, and plan the journey
        from Kanto through Sinnoh.
      </p>
    </header>
    <nav class="league-regions" aria-label="Choose region">
      <button data-region="all" aria-pressed="true">All regions</button>{
        regions.map((r) => (
          <button data-region={r.toLowerCase()} aria-pressed="false">
            {r}
          </button>
        ))
      }
    </nav>
    <div class="catalogue-controls">
      <label class="catalogue-query"
        ><span>Trainer, type, biome, or item</span><input
          data-league-query
          type="search"
          placeholder="Brock, Water, Onyx Stone…"
        /></label
      ><label
        ><span>Role</span><select data-league-role
          ><option value="">All checkpoints</option><option>Gym Leader</option
          ><option>Elite Four</option><option>Champion</option></select
        ></label
      ><label
        ><span>Checklist</span><select data-league-state
          ><option value="">All</option><option value="remaining"
            >Remaining</option
          ><option value="complete">Completed</option></select
        ></label
      >
    </div>
    <div class="league-progress">
      <div>
        <strong data-progress-label>0 / 52 complete</strong><p
          data-storage-note
        >
          Personal checklist · saved on this browser, separate from in-game
          progress.
        </p>
      </div><progress
        data-progress
        value="0"
        max="52"
        aria-label="Personal league progress"></progress><button data-clear
        >Clear checklist</button
      >
    </div>
    <p data-league-status role="status" aria-live="polite"></p>
    {
      regions.map((region, i) => (
        <section
          id={region.toLowerCase()}
          data-section={region.toLowerCase()}
          class="league-section"
        >
          <>
            <header class="league-region-heading">
              <>
                <img
                  src={withBase(`/assets/regions/${region.toLowerCase()}.webp`)}
                  width="800"
                  height="450"
                  alt={`${region} landscape illustration`}
                  loading="lazy"
                />
                <div>
                  <>
                    <span>
                      Region {i + 1} · 8 Gyms · 4 Elite Four · 1 Champion
                    </span>
                    <h2>{region}</h2>
                    <a href={withBase("/progression/regions/")}>
                      Regional progression →
                    </a>
                  </>
                </div>
              </>
            </header>
            <div class="league-grid">
              {regionalGyms
                .filter((t) => t.region === region)
                .map((t, i) => {
                  const id = slug(region + "-" + t.name);
                  return (
                    <article
                      class="league-trainer"
                      data-trainer={id}
                      data-region-name={region.toLowerCase()}
                      data-role={t.role}
                      data-search={[
                        t.name,
                        t.type,
                        t.badge,
                        t.location,
                        t.item,
                        t.role,
                      ]
                        .join(" ")
                        .toLowerCase()}
                    >
                      <div class="league-trainer-top">
                        <span>{String(i + 1).padStart(2, "0")}</span>
                        <span
                          class="catalogue-badge"
                          data-type={t.type.toLowerCase()}
                        >
                          {t.type}
                        </span>
                      </div>
                      <small>{t.role}</small>
                      <h3>{t.name}</h3>
                      {t.badge && <p class="league-badge">{t.badge}</p>}
                      <dl>
                        <div>
                          <dt>Location / biome</dt>
                          <dd>{t.location}</dd>
                        </div>
                        <div>
                          <dt>Signature item</dt>
                          <dd>{t.item}</dd>
                        </div>
                        {t.reward && (
                          <div>
                            <dt>Unique reward</dt>
                            <dd>{t.reward}</dd>
                          </div>
                        )}
                      </dl>
                      <label class="league-check">
                        <input
                          type="checkbox"
                          data-check={id}
                          aria-label={`Mark ${t.name} in ${region} complete`}
                        />
                        <span>Mark complete</span>
                      </label>
                    </article>
                  );
                })}
            </div>
          </>
        </section>
      ))
    }
    <p data-league-empty class="catalogue-empty" hidden>
      No checkpoints match these filters.
    </p>
    <section class="league-help" id="finding-gyms">
      <h2>Finding your next Gym</h2><ol>
        <li>Craft the Cartography Table for your active region.</li><li>
          Place it beside an unemployed villager to create a Map Guide.
        </li><li>
          Trade for a map, or combine an empty map with the Leader’s signature
          item.
        </li><li>
          Use a Battle Seeker when the nearest mapped structure has already been
          explored.
        </li>
      </ol><p>
        The Trainer Card is the authority for your checkpoint and level cap. In
        the public pack, Johto follows Champion Blue, Hoenn follows Lance, and
        Sinnoh follows Rocco. A world or server owner may need to restart before
        later-region structures generate in new chunks; players should follow
        staff instructions.
      </p>
    </section>
    <section class="league-help" id="unova">
      <h2>Beyond Sinnoh</h2><p>
        Unova is not included in this reference. Additional regions will be
        added when their leaders, locations, items, and progression rules are
        documented. Pack-localized names are retained here; checkpoint numbers
        show sequence, not battle levels.
      </p><a href={withBase("/sources/#lumy-hub")}>Guide origins & credits →</a>
    </section>
  </div><script>
    import "../../scripts/leagues";
  </script>
</BaseLayout>
