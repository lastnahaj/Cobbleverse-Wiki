---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/basePath";
import "../../styles/pokedex.css";
---

<BaseLayout
  title="Pokédex"
  description="Explore all 1,025 Pokémon with full artwork, type and generation filters, base stats, abilities, forms, evolution routes, moves, and Cobbleverse spawn data."
>
  <div class="dex" data-pokedex data-base={withBase("/")}>
    <nav class="dex-breadcrumb" aria-label="Breadcrumb">
      <a href={withBase("/")}>Wiki</a><span>/</span><a
        href={withBase("/training/")}>Pokémon & Training</a
      ><span>/</span><span>Pokédex</span>
    </nav>
    <header class="dex-header">
      <div class="dex-device">
        <span class="dex-lens" aria-hidden="true"></span><div>
          <span class="dex-eyebrow">Cobbleverse · Species reference</span><h1>
            National Pokédex
          </h1><p>Find a Pokémon. Get to know your next teammate.</p>
        </div>
      </div><div class="dex-total">
        <strong>1,025</strong><span>Pokémon to explore</span>
      </div>
    </header>
    <section class="dex-controls" aria-label="Pokédex filters">
      <label class="dex-search"
        ><span>Name, number, or ability</span><input
          type="search"
          data-dex-search
          placeholder="Search Pokémon…"
          autocomplete="off"
        /></label
      ><label
        ><span>Type</span><select data-dex-type
          ><option value="">All types</option>{
            [
              "bug",
              "dark",
              "dragon",
              "electric",
              "fairy",
              "fighting",
              "fire",
              "flying",
              "ghost",
              "grass",
              "ground",
              "ice",
              "normal",
              "poison",
              "psychic",
              "rock",
              "steel",
              "water",
            ].map((type) => (
              <option value={type}>
                {type[0].toUpperCase() + type.slice(1)}
              </option>
            ))
          }</select
        ></label
      ><label
        ><span>Generation</span><select data-dex-generation
          ><option value="">All generations</option>{
            Array.from({ length: 9 }, (_, i) => (
              <option value={i + 1}>Generation {i + 1}</option>
            ))
          }</select
        ></label
      ><label
        ><span>Sort by</span><select data-dex-sort
          ><option value="number">Pokédex number</option><option value="name"
            >Name A–Z</option
          ><option value="stats">Base stat total</option></select
        ></label
      ><button type="button" data-dex-reset>Reset</button>
    </section>
    <div class="dex-result-bar">
      <p role="status" aria-live="polite" data-dex-status>
        Loading the Pokédex…
      </p><span>Choose a Pokémon to open its entry</span>
    </div>
    <div class="dex-grid" data-dex-grid aria-label="Pokémon species"></div>
    <button type="button" class="dex-load" data-dex-more hidden
      >Show more Pokémon</button
    >
    <noscript
      ><p>
        Enable JavaScript to search the Pokédex and open species entries. The <a
          href={withBase("/training/")}>training guides</a
        > are available without it.
      </p></noscript
    >
    <footer class="dex-source">
      <p>
        Species data: Cobbleverse 1.7.42 reference snapshot. In-game
        availability can differ with server configuration.
      </p><p>
        Artwork: <a href="https://github.com/PokeAPI/sprites"
          >PokéAPI sprite repository</a
        > and <a href="https://play.pokemonshowdown.com/">Pokémon Showdown</a>.
        Pokémon artwork belongs to its respective owners. Form entries use
        matching artwork where available; custom forms without an image are
        labeled.
      </p>
    </footer>
    <dialog class="dex-dialog" aria-label="Pokémon entry" data-dex-dialog>
      <div data-dex-entry></div>
    </dialog>
  </div>
  <script>
    import "../../scripts/pokedex";
  </script>
</BaseLayout>
