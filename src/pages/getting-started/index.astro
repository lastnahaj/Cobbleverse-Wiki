---
import GuideSteps from "../../components/GuideSteps.astro";
import InfoCallout from "../../components/InfoCallout.astro";
import { server } from "../../data";
import { withBase } from "../../lib/basePath";
import PageShell from "../../layouts/PageShell.astro";

const steps = [
  {
    title: "Install the pack",
    description: `Install Minecraft ${server.minecraftVersion} with ${server.loader}, allocate at least 4 GB, and add the server address.`,
    href: withBase("/getting-started/install/"),
  },
  {
    title: "Review the resource pack",
    description:
      "Keep the bundled model and texture packs enabled so custom Pokémon and server visuals load.",
    href: withBase("/getting-started/resource-pack/"),
  },
  {
    title: "Orient at Spawn",
    description:
      "Use Spawn as your starting point for portals, services, and route navigation.",
    href: withBase("/worlds/spawn/"),
  },
  {
    title: "Begin in Kanto",
    description:
      "Kanto is the first stop in the structured regional progression route.",
    href: withBase("/progression/regions/"),
  },
  {
    title: "Claim your home",
    description:
      "Use Flan land protection and review the Pokémon actions controlled inside claims.",
    href: withBase("/getting-started/claims/"),
  },
  {
    title: "Learn useful commands",
    description:
      "Set a home, request teleports, use chat sharing, and open daily rewards.",
    href: withBase("/commands/"),
  },
  {
    title: "Learn the economy",
    description:
      "Start with Cobbledollars, Bazaar, and the verified currency directory.",
    href: withBase("/economy/"),
  },
];
const headings = [
  { depth: 2, slug: "before-you-join", text: "Before you join" },
  { depth: 2, slug: "first-route", text: "Your first route" },
  { depth: 2, slug: "need-help", text: "Need help?" },
];
---

<PageShell
  title="Getting Started"
  description="Install the Cobbleverse client, connect to the server, protect a build, and begin the Kanto route."
  category="Getting Started"
  hero="/assets/art-structures.webp"
  {headings}
  related={[
    {
      href: "/progression/",
      title: "Progression",
      description: "See how regional advancement works.",
    },
    {
      href: "/worlds/",
      title: "Worlds",
      description: "Explore the world directory.",
    },
  ]}
>
  <h2 id="before-you-join">Before you join</h2>
  <p>
    Cobbleverse is a {server.focus} for {server.game}. The confirmed platform is <strong
      >{server.loader} {server.minecraftVersion}</strong
    >. Connect at <code>{server.address}</code>.
  </p>
  <InfoCallout title="Use official sources"
    ><p>
      Current access instructions, downloads, and support belong on the <a
        href={server.discord}>Infinite Gaming Servers Discord</a
      > and <a href={server.website}>official website</a>.
    </p></InfoCallout
  >
  <h2 id="first-route">Your first route</h2>
  <GuideSteps {steps} />
  <h2 id="need-help">Need help?</h2>
  <p>
    Missing models, empty maps, launcher cache problems, and progression caps
    have a dedicated troubleshooting checklist.
  </p>
  <a
    class="button button--ghost"
    href={withBase("/getting-started/troubleshooting/")}
    >Open troubleshooting →</a
  >
</PageShell>
