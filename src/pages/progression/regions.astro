---
import { withBase } from "../../lib/basePath";
import "../../styles/leagues.css";
import InfoCallout from "../../components/InfoCallout.astro";
import RegionProgression from "../../components/RegionProgression.astro";
import { regions, regionalGyms } from "../../data";
import PageShell from "../../layouts/PageShell.astro";

const headings = [
  { depth: 2, slug: "route-order", text: "Route order" },
  { depth: 2, slug: "checkpoint-chains", text: "Checkpoint chains" },
  { depth: 2, slug: "unlock-model", text: "Unlock model" },
  { depth: 2, slug: "caps-and-locators", text: "Caps and locators" },
  { depth: 2, slug: "region-reference", text: "Region reference" },
];

const checkpointChains = [
  {
    region: "Kanto",
    band: "16–100",
  },
  {
    region: "Johto",
    band: "19–100",
  },
  {
    region: "Hoenn",
    band: "20–100",
  },
  {
    region: "Sinnoh",
    band: "28–100",
  },
];
---

<PageShell
  title="Region Progression"
  description="The structured Cobbleverse route from Kanto through Sinnoh."
  category="Progression"
  hero="/assets/sections/art-regional-route.webp"
  {headings}
  verified
  related={[
    { href: "/progression/", title: "Progression Overview" },
    { href: "/progression/ranks/", title: "Playtime Ranks" },
  ]}
>
  <h2 id="route-order">Route order</h2>
  <RegionProgression {regions} />
  <h2 id="checkpoint-chains">Checkpoint chains</h2>
  <p>
    Every visible region follows eight Gym Leaders, four Elite Four members,
    then one Champion. The broad level band is a source-data range, not a
    recommended level for every fight.
  </p>
  <div class="region-route-plans">
    {
      checkpointChains.map((chain, i) => (
        <details
          class="region-route-plan"
          name="regional-routes"
          open={i === 0}
        >
          <>
            <summary>
              <>
                <img
                  src={withBase(
                    "/assets/regions/" + chain.region.toLowerCase() + ".webp",
                  )}
                  width="800"
                  height="450"
                  alt=""
                  loading="lazy"
                />
                <span>
                  <>
                    <strong>{chain.region}</strong>
                    <small>
                      13 checkpoints · source level range {chain.band}
                    </small>
                  </>
                </span>
              </>
            </summary>
            <ol>
              {regionalGyms
                .filter((t) => t.region === chain.region)
                .map((t) => t.name)
                .map((trainer) => (
                  <li>{trainer}</li>
                ))}
            </ol>
            <a href={withBase("/gyms/#" + chain.region.toLowerCase())}>
              Open {chain.region} locations & checklist →
            </a>
          </>
        </details>
      ))
    }
  </div>
  <h2 id="unlock-model">Unlock model</h2>
  <p>
    The public pack advances through trainer series: eight Gym Leaders, an Elite
    Four, and a Champion. Defeating the Champion enables the next region's
    structures; restart the world or server once before exploring new chunks.
  </p>
  <InfoCallout
    ><p>
      Infinite Gaming Servers may automate parts of this process. Treat the
      in-game Trainer Card and staff announcements as the live server authority.
    </p></InfoCallout
  >
  <h2 id="caps-and-locators">Caps and locators</h2>
  <p>
    The in-game Trainer Card is the authority for the active region, trainer,
    and cap. Static planning values can help compare rosters, but they are not a
    substitute for the card. Gym and league locators are checkpoint-specific;
    craft the named output and use the compatible regional Cartography Table.
  </p>
  <p>
    Petra's documented locator example uses two Paper, one Pink Apricorn, and
    three Stone Slabs to craft the Rock Tome. The result targets Petra's Gym. Do
    not reuse that recipe for another checkpoint.
  </p>
  <h2 id="region-reference">Region reference</h2>
  <div class="table-scroll">
    <table>
      <thead
        ><tr
          ><th>Order</th><th>Region</th><th>Status</th><th
            >Unlock requirement</th
          ></tr
        ></thead
      ><tbody
        >{
          regions.map((region) => (
            <tr>
              <>
                <td>{region.order}</td>
                <td>
                  <strong>{region.name}</strong>
                </td>
                <td>{region.status}</td>
                <td>{region.unlockRequirement || "Starting region"}</td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>
  </div>
</PageShell>
