---
import { withBase } from "../../lib/basePath";
import CommandReferenceTable from "../../components/CommandReferenceTable.astro";
import InfoCallout from "../../components/InfoCallout.astro";
import { commands } from "../../data";
import PageShell from "../../layouts/PageShell.astro";

const headings = [
  { depth: 2, slug: "command-reference", text: "Command reference" },
  { depth: 2, slug: "publication-rules", text: "Publication rules" },
];
---

<PageShell
  title="Commands"
  description="Player-facing Cobbleverse commands from EEssentials, Cobblemon Extras, Daily Rewards, and Colosseum."
  category="Commands"
  {headings}
  verified
  lastUpdated="2026-08-24"
  related={[
    { href: "/getting-started/", title: "Getting Started" },
    { href: "/rules/", title: "Rules" },
  ]}
>
  <h2 id="command-reference">Command reference</h2>
  <CommandReferenceTable {commands} />
  <h2 id="publication-rules">Publication rules</h2>
  <p>
    This page lists player-oriented syntax documented by the installed mods.
    EEssentials modules and individual permission nodes can still be disabled or
    restricted by the server.
  </p>
  <InfoCallout title="Access can vary"
    ><p>
      A command appearing here means its syntax is sourced, not that every rank
      can use it. Staff-only deletion, odds, inventory, and configuration
      commands are intentionally omitted.
    </p></InfoCallout
  >
  <p>
    Sources: <a href={withBase("/sources/#mods")}>EEssentials commands</a>, <a
      href={withBase("/sources/#mods")}>Cobblemon Extras</a
    >, and <a href={withBase("/sources/#mods")}>Universal Daily Rewards</a>.
  </p>
</PageShell>
