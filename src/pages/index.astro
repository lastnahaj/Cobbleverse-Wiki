---
import { getCollection } from "astro:content";
import { regions, server } from "../data";
import { contentPath, withBase } from "../lib/basePath";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerStatus from "../components/ServerStatus.astro";

const guides = [
  {
    title: "Getting Started",
    text: "Join the server, set up your game, and begin your Cobbleverse journey.",
    href: "/getting-started/",
    icon: "getting-started",
    art: "kanto",
    label: "Your first steps",
  },
  {
    title: "Pokémon & Training",
    text: "Find Pokémon, build your team, and prepare for the next battle.",
    href: "/training/",
    icon: "progression",
    art: "hoenn",
    label: "Build your team",
  },
  {
    title: "Regional Progression",
    text: "Follow each region’s trainer route, badges, and legendary encounters.",
    href: "/progression/",
    icon: "worlds",
    art: "johto",
    label: "Choose your route",
  },
  {
    title: "Gyms & Battles",
    text: "Find Gym Leaders, take on the leagues, and explore battle facilities.",
    href: "/gyms/",
    icon: "gyms",
    art: "sinnoh",
    label: "Rise to the challenge",
  },
  {
    title: "Economy & Trading",
    text: "Compare merchants, trade Pokémon, and learn the player market.",
    href: "/economy/",
    icon: "economy",
    art: "kanto",
    label: "Trade & discover",
  },
  {
    title: "Server Systems",
    text: "Learn claims, rewards, quests, travel, and Pokémon workers.",
    href: "/features/",
    icon: "features",
    art: "hoenn",
    label: "Life on the server",
  },
];
const recent = (
  await getCollection("docs", ({ data }) => data.status === "published")
)
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 3);
const regionDescriptions: Record<string, string> = {
  kanto: "Your first badges. Your first league.",
  johto: "Towers, shrines, and new rivals.",
  hoenn: "Island routes and ancient legends.",
  sinnoh: "Mountain paths and the final league.",
};
const basics = [
  {
    title: "Join the server",
    copy: "Install the matching pack and connect to Cobbleverse.",
    href: "/getting-started/install/",
  },
  {
    title: "Choose your starter",
    copy: "Check your supplies, learn storage, and catch a teammate.",
    href: "/getting-started/first-session/",
  },
  {
    title: "Make yourself at home",
    copy: "Explore from Spawn and protect your first build.",
    href: "/getting-started/claims/",
  },
  {
    title: "Prepare for Kanto",
    copy: "Check the Trainer Card and plan your first Gym team.",
    href: "/team-building/",
  },
];
---

<BaseLayout
  title="Cobbleverse Wiki"
  description="Your Infinite Gaming Servers guide to Cobbleverse. Start playing, discover Pokémon, follow the regional leagues, and find your place on the server."
>
  <div class="adventure-home">
    <section class="adventure-hero" aria-labelledby="home-title">
      <img
        class="adventure-hero__scene"
        src={withBase("/assets/heroes/cobbleverse-village.webp")}
        width="1672"
        height="941"
        alt=""
        fetchpriority="high"
      />
      <div class="adventure-hero__shade"></div>
      <div class="adventure-hero__copy">
        <span class="eyebrow">Infinite Gaming Servers · Player wiki</span><h1
          id="home-title"
        >
          Your Cobbleverse<br />adventure starts <em>here.</em>
        </h1><p>
          Guides, Pokémon, regional leagues,<br class="desktop-break" /> and life
          on the server.
        </p><div class="button-row">
          <a class="button button--primary" href={withBase("/getting-started/")}
            ><span aria-hidden="true">◉</span> Start Playing</a
          ><a class="button button--ghost" href="#explore"
            ><span aria-hidden="true">▤</span> Explore the Wiki</a
          >
        </div>
      </div>
    </section>
    <div class="adventure-ribbon" aria-label="Server details">
      <span
        ><i aria-hidden="true">◆</i> Minecraft {server.minecraftVersion} · {
          server.loader
        }</span
      ><a href="#realm"><i aria-hidden="true">↗</i> {server.address}</a><a
        href="#realm"
        ><span class="ribbon-status-dot" aria-hidden="true"></span> Live realm status
        ↓</a
      >
    </div>
    <section class="adventure-section" id="explore">
      <div class="adventure-title adventure-title--center">
        <span></span><h2>What brings you here?</h2><span></span>
      </div><div class="adventure-guide-grid">
        {
          guides.map((guide) => (
            <a class="adventure-guide" href={withBase(guide.href)}>
              <>
                <img
                  class="adventure-guide__backdrop"
                  src={withBase(`/assets/regions/${guide.art}.webp`)}
                  width="1672"
                  height="941"
                  alt=""
                  loading="lazy"
                />
                <div class="adventure-guide__copy">
                  <>
                    <span class="adventure-kicker">{guide.label}</span>
                    <h3>{guide.title}</h3>
                    <p>{guide.text}</p>
                    <span class="adventure-guide__arrow" aria-hidden="true">
                      Explore →
                    </span>
                  </>
                </div>
                <img
                  class="adventure-guide__icon"
                  src={withBase(`/assets/icons/guide-${guide.icon}.webp`)}
                  width="320"
                  height="320"
                  alt=""
                  loading="lazy"
                />
              </>
            </a>
          ))
        }
      </div><nav class="adventure-shortcuts" aria-label="More references">
        <a href={withBase("/pokemon/")}>Pokédex ↗</a><a
          href={withBase("/items/")}>Items & recipes ↗</a
        ><a href={withBase("/worlds/")}>World & travel ↗</a><a
          href={withBase("/collectibles/")}>Collectibles ↗</a
        ><a href={withBase("/commands/")}>Commands ↗</a>
      </nav>
    </section>
    <section class="adventure-section journey-section">
      <div class="adventure-title">
        <h2>The regional journey</h2><p>
          One adventure. Four leagues to explore.
        </p><a href={withBase("/progression/regions/")}
          >View progression guide →</a
        >
      </div><div class="adventure-regions">
        {
          regions.map((region) => (
            <a class="adventure-region" href={withBase(`/gyms/#${region.id}`)}>
              <>
                <div class="adventure-region__image">
                  <>
                    <img
                      src={withBase(`/assets/regions/${region.id}.webp`)}
                      width="1672"
                      height="941"
                      alt=""
                      loading="lazy"
                    />
                    <span>{String(region.order).padStart(2, "0")}</span>
                  </>
                </div>
                <div class="adventure-region__copy">
                  <>
                    <h3>{region.name}</h3>
                    <p>{regionDescriptions[region.id]}</p>
                    <span>
                      Gyms & league <i aria-hidden="true">→</i>
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div><p class="adventure-footnote">
        Regional illustrations · Follow your in-game Trainer Card for the active
        checkpoint and level cap.
      </p>
    </section>
    <div class="adventure-two-column">
      <section class="adventure-section first-steps">
        <div class="adventure-title">
          <h2>Your first hour</h2><span></span>
        </div><p class="adventure-intro">
          A few good first steps make the whole journey easier.
        </p><ol>
          {
            basics.map((step, index) => (
              <li>
                <>
                  <span>{index + 1}</span>
                  <a href={withBase(step.href)}>
                    <>
                      <strong>{step.title}</strong>
                      <p>{step.copy}</p>
                    </>
                  </a>
                  <i aria-hidden="true">↗</i>
                </>
              </li>
            ))
          }
        </ol>
      </section><section class="adventure-section useful-guides">
        <div class="adventure-title">
          <h2>Keep these close</h2><span></span>
        </div><p class="adventure-intro">
          Quick answers for the things you do every session.
        </p><div>
          {
            [
              [
                "Find a command",
                "Homes, teleports, sharing, and rewards.",
                "/commands/",
              ],
              [
                "Find an item",
                "Materials, plates, mints, and fossils.",
                "/items/",
              ],
              [
                "Compare shops",
                "Merchants, offers, and reference prices.",
                "/battle/shops/",
              ],
              [
                "Get unstuck",
                "Models, maps, level caps, and support.",
                "/getting-started/troubleshooting/",
              ],
            ].map(([title, description, href]) => (
              <a href={withBase(href)}>
                <>
                  <strong>{title}</strong>
                  <span>{description}</span>
                  <i aria-hidden="true">→</i>
                </>
              </a>
            ))
          }
        </div>
      </section>
    </div>
    <section class="adventure-section adventure-beyond">
      <img
        src={withBase("/assets/sections/art-gym-arena.webp")}
        width="1672"
        height="941"
        alt=""
        loading="lazy"
      /><div>
        <span class="eyebrow">Beyond the badges</span><h2>
          There’s more to the journey.
        </h2><p>
          Try a battle facility, follow a quest, start a collection, or build
          something with friends.
        </p><nav aria-label="Beyond the leagues">
          {
            [
              ["Battle Tower", "/battle-tower/"],
              ["Colosseum", "/features/colosseum/"],
              ["Journey", "/features/journey/"],
              ["NeoPlushies", "/features/neoplushies/"],
            ].map(([title, href]) => <a href={withBase(href)}>{title} ↗</a>)
          }
        </nav>
      </div>
    </section>
    <section class="adventure-section adventure-realm" id="realm">
      <div>
        <span class="eyebrow">A shared world</span><h2>
          Your adventure has company.
        </h2><p>{server.address}</p><a href={server.discord}
          >Join the community on Discord ↗</a
        >
      </div><ServerStatus />
    </section>
    <section class="adventure-section adventure-recent">
      <div class="adventure-title">
        <h2>Fresh from the wiki</h2><span></span><a
          href={withBase("/changelog/")}>All updates →</a
        >
      </div><div>
        {
          recent.map((entry) => (
            <a href={contentPath(entry.id)}>
              <>
                <time datetime={entry.data.lastUpdated.toISOString()}>
                  {entry.data.lastUpdated.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
                <span>Read guide →</span>
              </>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
