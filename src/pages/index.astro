---
import { getCollection } from "astro:content";
import { navigation, regions, server } from "../data";
import { withBase, contentPath } from "../lib/basePath";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServerStatus from "../components/ServerStatus.astro";
const recent = (
  await getCollection("docs", ({ data }) => data.status === "published")
)
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 4);
const descriptions: Record<string, string> = {
  "Getting Started":
    "Install the pack, join the server, and prepare for your first session.",
  "Pokémon & Training":
    "Catch teammates, plan coverage, and learn how your Pokémon can help.",
  Progression:
    "Follow Kanto through Sinnoh, track your next checkpoint, and compare rank systems.",
  "Gyms & Battles":
    "Find regional leaders, prepare for leagues, and explore battle facilities.",
  "World & Travel":
    "Locate structures, plan expeditions, and find your way home.",
  "Economy & Trading":
    "Earn Cobbledollars, compare merchants, list Pokémon, and use auctions.",
  "Server Systems": "Learn quests, rewards, workers, claims, and server menus.",
  Collectibles:
    "Explore NeoPlushies and the collection systems documented for the server.",
};
const intents = navigation.filter((item) => descriptions[item.label]);
---

<BaseLayout
  title="Cobbleverse Wiki"
  description="Official Infinite Gaming Servers field guide. Join Cobbleverse, follow the regional leagues, find Pokémon, and learn server systems."
>
  <div class="atlas-home">
    <section class="atlas-hero">
      <div>
        <span class="eyebrow">Infinite Gaming Servers</span><h1>
          Cobbleverse Wiki
        </h1><p class="atlas-subtitle">Your guide to the journey ahead.</p><p>
          Find your next Gym, build your team, and make yourself at home.
        </p><div class="button-row">
          <a class="button button--primary" href={withBase("/getting-started/")}
            >Start playing <span>→</span></a
          ><button class="button button--ghost" data-search-open
            >Search the wiki <kbd>/</kbd></button
          >
        </div><div class="atlas-platform">
          Minecraft {server.minecraftVersion}<span>·</span>{server.loader}<span
            >·</span
          >Official server field guide
        </div>
      </div><img
        src={withBase("/assets/brand/cobbleverse-crest.webp")}
        alt="Cobbleverse Wiki crest"
        width="1254"
        height="1254"
        fetchpriority="high"
      />
    </section>
    <section class="atlas-section">
      <div class="atlas-section-heading">
        <h2>Find your next move</h2><a href={withBase("/guide-index/")}
          >Guide index →</a
        >
      </div><div class="intent-grid">
        {
          intents.map((item, i) => (
            <a href={withBase(item.href)}>
              <>
                <span class="intent-number">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <>
                    <h3>{item.label}</h3>
                    <p>{descriptions[item.label]}</p>
                  </>
                </div>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="atlas-section first-hour">
      <div class="atlas-section-heading">
        <div>
          <span class="eyebrow">A suggested starting route</span><h2>
            Your first hour
          </h2>
        </div><a href={withBase("/getting-started/first-session/")}
          >Read the starter guide →</a
        >
      </div><div class="hour-grid">
        <article>
          <span>01 · 0–10 minutes</span><h3>Begin</h3><p>
            Choose your starter, check your supplies, and learn the controls.
          </p><a href={withBase("/getting-started/first-session/")}
            >First login →</a
          >
        </article><article>
          <span>02 · 10–30 minutes</span><h3>Set out</h3><p>
            Explore from Spawn, use available travel commands, and protect a
            home.
          </p><a href={withBase("/getting-started/claims/")}
            >Claims and your first base →</a
          >
        </article><article>
          <span>03 · 30–60 minutes</span><h3>Become a trainer</h3><p>
            Check the Trainer Card, build a balanced party, and prepare for
            Kanto.
          </p><a href={withBase("/team-building/")}>Prepare your team →</a>
        </article>
      </div>
    </section>
    <section class="atlas-section">
      <div class="atlas-section-heading">
        <h2>The regional journey</h2><a href={withBase("/progression/regions/")}
          >Progression guide →</a
        >
      </div><div class="atlas-regions">
        {
          regions.map((region) => (
            <article>
              <>
                <span>
                  {String(region.order).padStart(2, "0")} · {region.status}
                </span>
                <h3>{region.name}</h3>
                <p>{region.unlockRequirement}</p>
                <a href={withBase(`/gyms/#${region.id}`)}>Gyms & league →</a>
              </>
            </article>
          ))
        }
      </div><p class="quiet-note">
        Follow the active Trainer Card for your current checkpoint and level
        cap. Server unlock requirements and future regions are published when
        confirmed.
      </p>
    </section>
    <section class="atlas-section beyond">
      <div>
        <span class="eyebrow">Beyond the leagues</span><h2>
          More ways to play
        </h2><p>
          Explore battle facilities, quests, automation, trading, and
          collections.
        </p>
      </div><div class="beyond-links">
        {
          [
            ["Battle Tower", "/battle-tower/"],
            ["Smart Trainers", "/features/smart-trainers/"],
            ["Colosseum", "/features/colosseum/"],
            ["NeoPlushies", "/features/neoplushies/"],
            ["Bazaar", "/economy/bazaar/"],
            ["Journey", "/features/journey/"],
          ].map(([title, href]) => (
            <a href={withBase(href)}>
              {title}
              <span>→</span>
            </a>
          ))
        }
      </div>
    </section>
    <section class="atlas-section realm">
      <div>
        <span class="eyebrow">Current realm status</span><h2>
          Play together.
        </h2><p>{server.address}</p>
      </div><ServerStatus />
    </section>
    <section class="atlas-section">
      <div class="atlas-section-heading">
        <h2>Recently updated guides</h2><a href={withBase("/changelog/")}
          >All updates →</a
        >
      </div><div class="recent-list">
        {
          recent.map((entry) => (
            <a href={contentPath(entry.id)}>
              <>
                <div>
                  <>
                    <strong>{entry.data.title}</strong>
                    <span>{entry.data.description}</span>
                  </>
                </div>
                <time datetime={entry.data.lastUpdated.toISOString()}>
                  {entry.data.lastUpdated.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
              </>
            </a>
          ))
        }
      </div>
    </section>
  </div></BaseLayout
>
