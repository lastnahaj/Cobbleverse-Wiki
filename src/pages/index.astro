---
import CategoryCard from "../components/CategoryCard.astro";
import FeatureStatusBadge from "../components/FeatureStatusBadge.astro";
import RegionProgression from "../components/RegionProgression.astro";
import ServerStatus from "../components/ServerStatus.astro";
import { features, regions, server } from "../data";
import { withBase } from "../lib/basePath";
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  {
    title: "Getting Started",
    description:
      "Prepare your client, orient at spawn, and protect your first build.",
    href: "/getting-started/",
    image: "/assets/icon-getting-started.webp",
  },
  {
    title: "Progression",
    description: "Follow the regional Pokédex route from Kanto through Sinnoh.",
    href: "/progression/",
    image: "/assets/icon-progression.webp",
  },
  {
    title: "Gyms",
    description:
      "Find regional leaders, signature items, leagues, and Champions.",
    href: "/gyms/",
    image: "/assets/icon-gyms.webp",
  },
  {
    title: "Worlds",
    description:
      "Find structures, spawns, mounts, maps, portals, and destinations.",
    href: "/worlds/",
    image: "/assets/icon-worlds.webp",
  },
  {
    title: "Economy",
    description:
      "Earn currency, shop with merchants, and use Bazaar and auctions.",
    href: "/economy/",
    image: "/assets/icon-economy.webp",
  },
  {
    title: "Features",
    description:
      "Use quests, rewards, automation, claims, lures, and battle systems.",
    href: "/features/",
    image: "/assets/icon-features.webp",
  },
];
const featuredSystems = features.filter((feature) =>
  ["journey", "cobbleworkers", "daily-rewards", "smart-trainers"].includes(
    feature.id,
  ),
);
---

<BaseLayout
  title="Cobbleverse Wiki"
  description="A player field guide for the Cobbleverse Cobblemon server by Infinite Gaming Servers."
>
  <div class="home-wrap">
    <section class="home-hero" aria-labelledby="home-title">
      <img
        class="home-hero__scene"
        src={withBase("/assets/art-structures.webp")}
        width="1672"
        height="941"
        alt="Voxel landscape with regional towers, temples, and glowing portals"
        fetchpriority="high"
      />
      <div class="home-hero__veil" aria-hidden="true"></div>
      <img
        class="home-hero__logo"
        src={withBase("/assets/cobbleverse-wordmark.webp")}
        width="1672"
        height="941"
        alt=""
      />
    </section>
    <section class="hero-dock">
      <div>
        <span class="eyebrow">Infinite Gaming Servers</span>
        <h1 id="home-title">Your Cobbleverse field guide</h1>
        <p>
          Install the pack, follow the regional leagues, find special
          encounters, and learn the server's commands and systems.
        </p>
      </div>
      <div class="hero-dock__actions">
        <a class="button button--primary" href={withBase("/getting-started/")}
          >Start here <span>→</span></a
        >
        <button class="button button--search" type="button" data-search-open
          ><span aria-hidden="true">⌕</span> Search the wiki <kbd>/</kbd
          ></button
        >
      </div>
    </section>

    <section class="server-ribbon" aria-label="Server overview">
      <div><span>Server</span><strong>{server.name}</strong></div>
      <div>
        <span>Platform</span><strong
          >{server.loader} {server.minecraftVersion}</strong
        >
      </div>
      <div><span>Address</span><strong>{server.address}</strong></div>
      <ServerStatus />
    </section>

    <section
      class="home-section home-sections"
      aria-labelledby="explore-heading"
    >
      <header class="section-heading">
        <div>
          <span class="eyebrow">Route index</span><h2 id="explore-heading">
            Explore the field guide
          </h2>
        </div><p>
          Begin with a major system, or use global search from any page.
        </p>
      </header>
      <div class="category-grid">
        {categories.map((category) => <CategoryCard {...category} />)}
      </div>
      <div class="reference-strip">
        <a href={withBase("/commands/")}
          ><span class="reference-mark" aria-hidden="true"
            ><img
              src={withBase("/assets/icon-commands.webp")}
              width="320"
              height="320"
              alt=""
              loading="lazy"
            /></span
          ><span
            ><strong>Commands</strong><small>Player command reference</small
            ></span
          ><i>→</i></a
        >
        <a href={withBase("/rules/")}
          ><span class="reference-mark" aria-hidden="true"
            ><img
              src={withBase("/assets/icon-rules.webp")}
              width="320"
              height="320"
              alt=""
              loading="lazy"
            /></span
          ><span
            ><strong>Rules</strong><small>Authoritative policy area</small
            ></span
          ><i>→</i></a
        >
        <a href={withBase("/changelog/")}
          ><span class="reference-mark" aria-hidden="true"
            ><img
              src={withBase("/assets/icon-changelog.webp")}
              width="320"
              height="320"
              alt=""
              loading="lazy"
            /></span
          ><span
            ><strong>Changelog</strong><small
              >Wiki updates and dated notices</small
            ></span
          ><i>→</i></a
        >
      </div>
    </section>

    <section
      class="home-section progression-feature"
      aria-labelledby="progression-heading"
    >
      <div class="progression-feature__art">
        <img
          src={withBase("/assets/art-regional-route.webp")}
          width="1672"
          height="941"
          alt="Progression route through a mountainous Cobbleverse region"
          loading="lazy"
        />
      </div>
      <div class="progression-feature__copy">
        <span class="eyebrow">Regional progression</span>
        <h2 id="progression-heading">Four leagues. One connected route.</h2>
        <p>
          Defeat each region's Gym Leaders, Elite Four, and Champion to open the
          next series and its structures.
        </p>
        <RegionProgression {regions} compact />
        <a class="text-link" href={withBase("/progression/regions/")}
          >View the full regional route →</a
        >
      </div>
    </section>

    <section
      class="home-section battle-feature"
      aria-labelledby="battle-heading"
    >
      <div class="battle-feature__copy">
        <span class="eyebrow">Battle systems</span>
        <h2 id="battle-heading">Regional leagues meet smarter battles</h2>
        <p>
          Browse every published leader and signature item, then prepare for
          Smart Trainers, Colosseum facilities, and the Battle Tower.
        </p>
        <div class="battle-tags">
          <span>Sweeper</span><span>Stall</span><span>Weather</span><span
            >Trick Room</span
          ><span>Tower Masters</span>
        </div>
        <div class="button-row">
          <a class="button button--primary" href={withBase("/gyms/")}
            >Explore Gyms</a
          ><a class="button button--ghost" href={withBase("/battle-tower/")}
            >Battle Tower</a
          >
        </div>
      </div>
      <div class="battle-feature__art">
        <img
          src={withBase("/assets/art-gym-arena.webp")}
          width="1672"
          height="941"
          alt="Cobbleverse Gym arena under dramatic evening light"
          loading="lazy"
        />
      </div>
    </section>

    <section
      class="home-section systems-feature"
      aria-labelledby="systems-heading"
    >
      <div class="systems-feature__lead">
        <img
          src={withBase("/assets/art-server-systems.webp")}
          width="1672"
          height="941"
          alt="Cobbleverse technology and feature control room"
          loading="lazy"
        />
        <div>
          <span class="eyebrow">Server systems</span><h2 id="systems-heading">
            Server systems, explained in one place
          </h2><p>
            Learn quests, markets, lures, daily rewards, automation, menus,
            claims, and Pokémon utility commands.
          </p>
        </div>
      </div>
      <div class="system-list">
        {
          featuredSystems.map((feature) => (
            <a href={withBase(`/features/${feature.id}/`)}>
              <>
                <span>
                  <>
                    <strong>{feature.name}</strong>
                    <small>{feature.category}</small>
                  </>
                </span>
                <FeatureStatusBadge status={feature.status} />
              </>
            </a>
          ))
        }
      </div>
    </section>

    <section class="home-section home-update-links">
      <div class="updates-panel">
        <span class="eyebrow">Latest wiki changes</span>
        <h2>Field guide update</h2>
        <div class="update-entry">
          <time datetime="2026-08-24">Aug 24</time><div>
            <strong>Lumy Hub guides integrated</strong><p>
              Regional Gyms, structures, special encounters, forms, settings,
              installation, and troubleshooting are now organized for players.
            </p>
          </div>
        </div>
        <div class="update-entry">
          <time datetime="2026-08-24">Aug 24</time><div>
            <strong>Live server status connected</strong><p>
              The homepage and header now show aggregate online player counts
              for the Cobbleverse server.
            </p>
          </div>
        </div>
        <a class="text-link" href={withBase("/changelog/")}
          >Read the changelog →</a
        >
      </div>
      <div class="community-panel">
        <span class="eyebrow">Continue the adventure</span>
        <h2>Official server links</h2>
        <p>
          Use official community channels for current server access, support,
          and announcements.
        </p>
        <a href={server.discord}
          ><strong>Infinite Gaming Servers Discord</strong><span
            >Community support and announcements ↗</span
          ></a
        >
        <a href={server.website}
          ><strong>Infinite Gaming Servers</strong><span
            >Official network website ↗</span
          ></a
        >
      </div>
    </section>
  </div>
</BaseLayout>
