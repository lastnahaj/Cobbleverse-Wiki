---
import CurrencyCard from "../../components/CurrencyCard.astro";
import WarningCallout from "../../components/WarningCallout.astro";
import { currencies } from "../../data";
import PageShell from "../../layouts/PageShell.astro";

const headings = [
  { depth: 2, slug: "current-currencies", text: "Current currencies" },
  { depth: 2, slug: "event-records", text: "Event and legacy records" },
];
const currentCurrencies = currencies.filter(
  (currency) => currency.active === true,
);
const eventRecords = currencies.filter((currency) => currency.active === null);
---

<PageShell
  title="Currencies"
  description="Cobbleverse currencies, vouchers, tokens, passes, and event records."
  category="Economy"
  hero="/assets/sections/art-server-systems.webp"
  {headings}
  verified
  related={[
    { href: "/economy/", title: "Economy Overview" },
    { href: "/economy/bazaar/", title: "Bazaar" },
  ]}
>
  <h2 id="current-currencies">Current currencies</h2>
  <div class="currency-grid currency-grid--all">
    {currentCurrencies.map((currency) => <CurrencyCard {currency} />)}
  </div>
  <h2 id="event-records">Event and legacy records</h2>
  <p>
    These entries are preserved for event and historical reference. Their
    presence here does not mean they are currently obtainable.
  </p>
  <div class="currency-grid currency-grid--all">
    {eventRecords.map((currency) => <CurrencyCard {currency} />)}
  </div>
  <WarningCallout
    ><p>
      Prices, exchange rates, and redemption options can change with server
      shops and events. Use the current in-game menu as the final authority.
    </p></WarningCallout
  >
</PageShell>
