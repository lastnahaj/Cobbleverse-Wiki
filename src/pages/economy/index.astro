---
import CurrencyCard from "../../components/CurrencyCard.astro";
import InfoCallout from "../../components/InfoCallout.astro";
import { currencies, features, server } from "../../data";
import { withBase } from "../../lib/basePath";
import PageShell from "../../layouts/PageShell.astro";

const primary = currencies
  .filter((currency) => currency.active === true)
  .slice(0, 3);
const bazaar = features.find((feature) => feature.id === "bazaar");
const headings = [
  { depth: 2, slug: "economy-map", text: "Economy map" },
  { depth: 2, slug: "currencies", text: "Currencies" },
  { depth: 2, slug: "non-p2w-policy", text: "Non-P2W policy" },
];
---

<PageShell
  title="Economy"
  description="Earn currency, trade through Bazaar and the Auction House, and use CobbleMerchants and reward systems."
  category="Economy"
  hero="/assets/art-server-systems.webp"
  {headings}
  related={[
    { href: "/economy/bazaar/", title: "Bazaar" },
    { href: "/economy/currencies/", title: "Currency Directory" },
  ]}
>
  <h2 id="economy-map">Economy map</h2>
  <div class="economy-map">
    <div>
      <span>01</span><strong>Earn</strong><p>
        Battle wild Pokémon and trainers, sell supported items, and collect
        configured rewards.
      </p>
    </div><div>
      <span>02</span><strong>Trade</strong><p>
        Use fixed-price Pokémon listings, item auctions, and direct player
        trades.
      </p>
    </div><div>
      <span>03</span><strong>Spend</strong><p>
        Shop through CobbleMerchants, village Poké Marts, shopping centers, and
        server menus.
      </p>
    </div>
  </div>
  {
    bazaar && (
      <p>
        <a class="button button--ghost" href={withBase("/economy/bazaar/")}>
          Bazaar reference · {bazaar.status}
        </a>
      </p>
    )
  }
  <h2 id="currencies">Currencies</h2>
  <div class="currency-grid">
    {primary.map((currency) => <CurrencyCard {currency} />)}
  </div>
  <p>
    <a class="text-link" href={withBase("/economy/currencies/")}
      >View all active and unknown-status currency records →</a
    >
  </p>
  <h2 id="non-p2w-policy">Non-P2W policy</h2>
  <p>
    {server.name} is intended to remain non-P2W. Donor ranks are not described as
    granting exclusive Pokémon, combat kits, progression shortcuts, command advantages,
    or paid combat power.
  </p>
  <InfoCallout title="Live menus are authoritative"
    ><p>
      Merchant stock, Bazaar fees, auction limits, and reward values can change
      with server configuration. Review the confirmation screen before spending.
    </p></InfoCallout
  >
</PageShell>
