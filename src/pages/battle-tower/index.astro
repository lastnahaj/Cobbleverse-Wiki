---
import InfoCallout from "../../components/InfoCallout.astro";
import WarningCallout from "../../components/WarningCallout.astro";
import PageShell from "../../layouts/PageShell.astro";

const tiers = Array.from({ length: 13 }, (_, index) => index + 1);
const archetypes = [
  "Sweeper",
  "Stall",
  "Hyper Offense",
  "Weather",
  "Trick Room",
  "Tower Masters",
];
const headings = [
  {
    depth: 2,
    slug: "thirteen-tier-structure",
    text: "Thirteen-tier structure",
  },
  { depth: 2, slug: "trainer-archetypes", text: "Trainer archetypes" },
  { depth: 2, slug: "configuration-boundary", text: "Configuration boundary" },
];
---

<PageShell
  title="Battle Tower"
  description="Prepare for thirteen escalating Battle Tower tiers powered by configurable Smart Trainer AI."
  category="Gyms"
  hero="/assets/art-gym-arena.webp"
  {headings}
  related={[
    { href: "/gyms/", title: "Gym Directory" },
    { href: "/features/smart-trainers/", title: "Smart Trainers" },
  ]}
>
  <p>
    The Battle Tower is structured for <strong>13 NPC tiers</strong>. Smart
    Trainers can evaluate moves, switches, items, prediction, priorities, and
    battle gimmicks at different skill levels.
  </p>
  <h2 id="thirteen-tier-structure">Thirteen-tier structure</h2>
  <div class="tower-tiers">
    {
      tiers.map((tier) => (
        <div>
          <>
            <span>{String(tier).padStart(2, "0")}</span>
            <strong>Tier {tier}</strong>
            <small>Configuration pending</small>
          </>
        </div>
      ))
    }
  </div>
  <InfoCallout title="Escalating difficulty"
    ><p>
      Exact opponents, rewards, entry conditions, and assigned AI profiles are
      controlled by the server.
    </p></InfoCallout
  >
  <h2 id="trainer-archetypes">Trainer archetypes</h2>
  <div class="archetype-grid">
    {
      archetypes.map((archetype) => (
        <div>
          <>
            <i aria-hidden="true" />
            <strong>{archetype}</strong>
            <span>Configured through Smart Trainers</span>
          </>
        </div>
      ))
    }
  </div>
  <h2 id="configuration-boundary">Configuration boundary</h2>
  <WarningCallout
    ><p>
      Do not assume an archetype from a trainer's name alone. The server can
      assign personalities, prediction, battle bags, and gimmicks per encounter.
    </p></WarningCallout
  >
</PageShell>
