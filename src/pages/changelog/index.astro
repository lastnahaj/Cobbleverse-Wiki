---
import PageShell from "../../layouts/PageShell.astro";
import { updates } from "../../data/updates";
---

<PageShell
  title="Changelog & Notices"
  description="Dated wiki releases and confirmed server notices."
  category="Changelog"
  ><label
    >Update type <select id="update-filter"
      ><option value="">All updates</option>{
        ["wiki", "server", "event", "maintenance", "breaking"].map((kind) => (
          <option value={kind}>{kind}</option>
        ))
      }</select
    ></label
  ><div class="update-list">
    {
      updates.map((update) => (
        <section data-update-kind={update.kind}>
          <>
            <p class="quiet-note">
              <time datetime={update.date}>{update.date}</time> · {update.kind}
            </p>
            <h2>{update.title}</h2>
            <p>{update.description}</p>
          </>
        </section>
      ))
    }
  </div><p>
    No temporary server notices are currently published here. Check Discord for
    live announcements.
  </p></PageShell
>
<script>
  document
    .querySelector<HTMLSelectElement>("#update-filter")
    ?.addEventListener("change", (event) => {
      const kind = (event.target as HTMLSelectElement).value;
      document
        .querySelectorAll<HTMLElement>("[data-update-kind]")
        .forEach(
          (row) => (row.hidden = !!kind && row.dataset.updateKind !== kind),
        );
    });
</script>
