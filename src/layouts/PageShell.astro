---
import ArticleTOC from "../components/ArticleTOC.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import HeroBanner from "../components/HeroBanner.astro";
import LastVerified from "../components/LastVerified.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import WikiSidebar from "../components/WikiSidebar.astro";
import BaseLayout from "./BaseLayout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface RelatedLink {
  href: string;
  title: string;
  description?: string;
}
interface Props {
  title: string;
  description: string;
  category: string;
  hero?: string;
  headings?: Heading[];
  verified?: boolean;
  lastUpdated?: Date | string;
  related?: RelatedLink[];
  noindex?: boolean;
  verificationScope?: string;
  sources?: string[];
  serverVersion?: string;
}

const {
  title,
  description,
  category,
  hero,
  headings = [],
  verified = false,
  lastUpdated,
  related = [],
  noindex = false,
  verificationScope,
  sources = [],
  serverVersion,
} = Astro.props;

const categoryPaths: Record<string, string> = {
  "Getting Started": "/getting-started/",
  Progression: "/progression/",
  "Pokémon & Training": "/training/",
  Collectibles: "/collectibles/",
  Pokédex: "/pokemon/",
  Gyms: "/gyms/",
  Worlds: "/worlds/",
  Items: "/items/",
  "Battle & Shops": "/battle/",
  Reference: "/guide-index/",
  Economy: "/economy/",
  Features: "/features/",
  Commands: "/commands/",
  Rules: "/rules/",
  Changelog: "/changelog/",
};
const categoryPath = categoryPaths[category];
const breadcrumbs = [
  { label: "Home", href: "/" },
  ...(title !== category && categoryPath
    ? [{ label: category, href: categoryPath }]
    : []),
  { label: title },
];
---

<BaseLayout {title} {description} image={hero} {noindex}>
  <div class="page-wrap">
    <Breadcrumbs items={breadcrumbs} />
    {
      hero &&
        ![
          "Pokédex",
          "Items",
          "Battle & Shops",
          "Commands",
          "Features",
        ].includes(category) && (
          <HeroBanner src={hero} alt={`${title} section artwork`} eager />
        )
    }
    <header class="page-intro">
      <span class="eyebrow"
        >{category === "Features" ? "Server Systems" : category} · Field guide</span
      >
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="article-grid">
      <WikiSidebar />
      <article class="article-content prose">
        {
          verificationScope && (
            <p class="quiet-note">
              {verificationScope === "server"
                ? "Verified on Cobbleverse"
                : verificationScope === "base-pack"
                  ? "Base-pack reference"
                  : verificationScope === "upstream"
                    ? "Upstream capability reference"
                    : "Configuration awaiting verification"}
              {serverVersion && ` · ${serverVersion}`}
            </p>
          )
        }
        <slot />
        {
          sources.length > 0 && (
            <p class="quiet-note">
              Sources:{" "}
              {sources.map((source, index) => (
                <a href={source}>Reference {index + 1} </a>
              ))}
            </p>
          )
        }
        <LastVerified date={lastUpdated} {verified} />
        <RelatedArticles links={related} />
        <nav class="article-actions" aria-label="Article tools">
          <a href="https://github.com/lastnahaj/Cobbleverse-Wiki/tree/main/src"
            >View source</a
          ><a href="https://github.com/lastnahaj/Cobbleverse-Wiki/issues/new"
            >Report a correction</a
          >
        </nav>
        <slot name="after" />
      </article>
      <ArticleTOC headings={headings} />
    </div>
  </div>
</BaseLayout>
